POSTGRES_DB=moldy_market
POSTGRES_USER=moldy_user
POSTGRES_PASSWORD=your_local_password
POSTGRES_PORT=5432

# Generate a secure secret (min 64 random chars / 512-bit):
#   PowerShell: $rng = New-Object System.Security.Cryptography.RNGCryptoServiceProvider; $b = New-Object byte[] 64; $rng.GetBytes($b); [Convert]::ToBase64String($b)
#   Linux/Mac:  openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_MINIMUM_64_RANDOM_CHAR_SECRET

DB_HOST=localhost
DB_PORT=5432
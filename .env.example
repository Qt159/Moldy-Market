# Copy to /etc/moldy-market/moldy.env for production. Replace every placeholder.
# EC2 IAM role supplies AWS credentials; do not add static AWS access keys here.

# Application
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=<https://your-frontend-origin>

# PostgreSQL / RDS
DB_URL=<jdbc:postgresql://your-rds-host:5432/your-database?sslmode=verify-full>
DB_USERNAME=<database-user>
DB_PASSWORD=<database-password>
DB_SSL_ROOT_CERT=/etc/moldy-market/global-bundle.pem

# JWT (at least 32 bytes of unpredictable secret material)
JWT_SECRET=<random-secret-at-least-32-characters>
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=2592000000

# Initial admin account (existing account password is not reset on startup)
ADMIN_EMAIL=<admin-email>
ADMIN_PASSWORD=<initial-admin-password>
ADMIN_FULL_NAME=<admin-display-name>

# AWS (EC2 instance role)
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=<s3-bucket-name>
AWS_DYNAMODB_NOTIFICATIONS_TABLE=<notifications-table-name>
# Optional; normally blank in EC2 production. Only set for a DynamoDB-compatible endpoint.
AWS_DYNAMODB_ENDPOINT=
# Set both values only after the SQS queue/Lambda/DLQ are ready.
NOTIFICATIONS_OUTBOX_ENABLED=false
AWS_SQS_NOTIFICATION_QUEUE_URL=

# Brevo Transactional Email
BREVO_API_KEY=<brevo-api-key>
BREVO_SENDER_EMAIL=<verified-sender-email>
BREVO_SENDER_NAME=Moldy Market

# SePay QR generation and webhook verification
SEPAY_BANK_ACCOUNT=<bank-account-number>
SEPAY_BANK_NAME=<bank-code>
SEPAY_WEBHOOK_SECRET_KEY=<sepay-webhook-hmac-secret>

# Rate limiting and notifications
APP_RATE_LIMIT_STORE=redis
SPRING_DATA_REDIS_HOST=<redis-host>
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=<redis-password>

# Production API documentation should remain disabled unless explicitly approved.
SPRINGDOC_SWAGGER_UI_ENABLED=false

# Optional SMTP fallback. Brevo is the primary mail provider.
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-username>
MAIL_PASSWORD=<smtp-password>
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

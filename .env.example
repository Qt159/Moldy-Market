POSTGRES_DB=moldy_market
POSTGRES_USER=moldy_user
POSTGRES_PASSWORD=your_local_password
POSTGRES_PORT=5432


JWT_SECRET=<random-secret-at-least-32-characters>

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=

DB_URL=jdbc:postgresql://localhost:5432/moldy_market
DB_USERNAME=moldy_user
DB_PASSWORD=your_local_password

CORS_ALLOWED_ORIGINS=http://localhost:5173
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=moldy-market-local
AWS_SQS_NOTIFICATION_QUEUE_URL=http://localhost:9324/queue/local-notifications
AWS_SNS_NOTIFICATION_TOPIC_ARN=
AWS_DYNAMODB_NOTIFICATIONS_TABLE=notifications

# Brevo transactional email. Leave the API key empty for local Swagger-only use.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@moldymarket.local
BREVO_SENDER_NAME=Moldy Market

SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_BANK_ACCOUNT=0000000000
SEPAY_BANK_NAME=LOCAL
SEPAY_WEBHOOK_SECRET_KEY=local-only-webhook-secret

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@moldymarket.local

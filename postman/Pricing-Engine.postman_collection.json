  "item": [
    {
      "name": "Auto Pricing",
      "description": "Auto Pricing endpoints",
      "item": [
        {
          "name": "1. TC-AUTO-001: Basic Auto Pricing",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"00000000-0000-0001-0000-000000000001\",\n  \"modelId\": \"{{modelIdIphone15ProMax}}\",\n  \"origin\": \"OFFICIAL_VN\",\n  \"warrantyStatus\": \"EXPIRED_UNDER_1Y\",\n  \"conditionLevel\": \"SCRATCHED\",\n  \"usageMonths\": 10\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/pricing/auto",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pricing", "auto"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// TC-AUTO-001: Basic Auto Pricing - All Factors at Neutral",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response structure is correct\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('success', true);",
                  "    pm.expect(jsonData.data).to.have.property('pricingMode', 'AUTO');",
                  "    pm.expect(jsonData.data).to.have.property('status', 'SUGGESTED');",
                  "});",
                  "",
                  "pm.test(\"Calculation is correct (17.6M = 28M × 0.72 × 0.90 × 0.97)\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var suggestedPrice = jsonData.data.suggestedPrice;",
                  "    // 28,000,000 × 0.72 × 0.90 × 0.97 = 17,599,680 → round to 17,600,000",
                  "    pm.expect(suggestedPrice).to.equal(17600000);",
                  "});",
                  "",
                  "pm.test(\"All factors are present and correct\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.deprecationFactor).to.equal(0.72);",
                  "    pm.expect(jsonData.data.conditionFactor).to.equal(0.90);",
                  "    pm.expect(jsonData.data.warrantyFactor).to.equal(0.97);",
                  "});",
                  "",
                  "pm.test(\"Disclaimer is present\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.disclaimer).to.include('Giá tham khảo');",
                  "});"
                ]
              }
            }
          ]
        },

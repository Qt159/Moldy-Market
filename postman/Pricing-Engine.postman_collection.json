    {
      "name": "Reference Price Management",
      "description": "Admin endpoints for managing reference prices",
      "item": [
        {
          "name": "1. TC-REF-001: Create reference price",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"00000000-0000-0001-0000-000000000001\",\n  \"brand\": \"Apple\",\n  \"modelName\": \"iPhone 15 Pro Max\",\n  \"referencePrice\": 28000000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/reference-prices",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "reference-prices"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// TC-REF-001: Create reference price",
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response contains correct fields\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.have.property('id');",
                  "    pm.expect(jsonData.data).to.have.property('brand', 'Apple');",
                  "    pm.expect(jsonData.data).to.have.property('modelName', 'iPhone 15 Pro Max');",
                  "    pm.expect(jsonData.data).to.have.property('referencePrice', 28000000);",
                  "    pm.expect(jsonData.data).to.have.property('currency', 'VND');",
                  "});",
                  "",
                  "// Store modelId for future tests",
                  "pm.environment.set('modelIdIphone15ProMax', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
